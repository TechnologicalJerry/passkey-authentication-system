# ==============================================================================
# Passkey Authentication System - Environment Configuration
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=passkey_auth
DATABASE_SSL=false
# Optional full connection URL (overrides discrete settings if provided)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/passkey_auth

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting (Throttler)
# TTL in milliseconds
THROTTLE_TTL=60000
# Max requests per IP within the TTL window
THROTTLE_LIMIT=100

# Logging (Pino)
# Valid levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# API Documentation (Swagger/OpenAPI)
# Automatically disabled in production unless explicitly set to true
SWAGGER_ENABLED=true


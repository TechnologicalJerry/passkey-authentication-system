# ==============================================================================
# Passkey Authentication System - Environment Configuration
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=passkey_auth
DATABASE_SSL=false
# Optional full connection URL (overrides discrete settings if provided)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/passkey_auth

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting (Throttler)
# TTL in milliseconds
THROTTLE_TTL=60000
# Max requests per IP within the TTL window
THROTTLE_LIMIT=100

# Logging (Pino)
# Valid levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# API Documentation (Swagger/OpenAPI)
# Automatically disabled in production unless explicitly set to true
SWAGGER_ENABLED=true

# WebAuthn / FIDO2 Relying Party Configuration
RP_NAME=Passkey Authentication System
RP_ID=localhost
# Comma-separated list of allowed frontend origins for WebAuthn assertion/attestation
RP_ORIGIN=http://localhost:3000,http://localhost:3001
# Challenge expiration time in milliseconds (e.g., 60000 = 60 seconds)
CHALLENGE_TTL_MS=60000
# User verification requirement: preferred | required | discouraged
USER_VERIFICATION=preferred

# JWT Access Token Configuration
# Minimum 32-character secret for HMAC-SHA256 signing
JWT_ACCESS_SECRET=dev-jwt-access-secret-min-32-chars-key!
# Access token expiration (e.g., 15m, 1h)
JWT_ACCESS_TTL=15m
JWT_ISSUER=passkey-auth-api
JWT_AUDIENCE=passkey-auth-app

# Session & Refresh Token Configuration
# Refresh token retention window in days (1 - 90)
REFRESH_TOKEN_TTL_DAYS=7
# Secret key for HMAC-SHA256 hashing of refresh tokens (never store raw tokens)
REFRESH_TOKEN_SECRET=dev-refresh-token-hmac-salt-32-chars!
# Maximum allowed active sessions per user (oldest session evicted upon limit)
MAX_ACTIVE_SESSIONS_PER_USER=5
# Name of the HttpOnly cookie transporting the refresh token
COOKIE_NAME=refresh_token
# Force secure cookies (HTTPS only; defaults to true in production)
COOKIE_SECURE=false
# Cookie SameSite attribute: lax | strict | none
COOKIE_SAME_SITE=lax
